{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davylab-designos.pages.dev/schemas/design-candidate.schema.json",
  "title": "DAVYLAB DesignOS Design Candidate",
  "description": "Normalized, provenance-aware candidate generated from a product brief and real design-engine evidence. This schema does not itself assert that a candidate was generated by the upstream engine.",
  "type": "object",
  "required": ["schemaVersion", "candidateId", "brief", "direction", "decision", "evidence", "preview", "delivery", "rawEngineOutput"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "candidateId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "brief": {
      "type": "object",
      "required": ["productDescription", "productCategory", "targetPlatform"],
      "properties": {
        "productDescription": { "type": "string", "minLength": 1 },
        "productCategory": { "type": "string", "minLength": 1 },
        "targetAudience": { "type": "string" },
        "primaryTasks": { "type": "array", "items": { "type": "string" } },
        "targetPlatform": { "type": "string", "enum": ["web", "mobile-web", "ios", "android", "desktop", "multi-platform", "unknown"] },
        "techStack": { "type": "array", "items": { "type": "string" } },
        "brandPreferences": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "direction": {
      "type": "object",
      "required": ["name", "summary", "layoutStrategy", "interactionStrategy", "tradeoffs"],
      "properties": {
        "name": { "type": "string" },
        "summary": { "type": "string" },
        "designDials": {
          "type": "object",
          "properties": {
            "variance": { "type": ["integer", "null"], "minimum": 1, "maximum": 10 },
            "variance_label": { "type": ["string", "null"] },
            "motion": { "type": ["integer", "null"], "minimum": 1, "maximum": 10 },
            "motion_label": { "type": ["string", "null"] },
            "density": { "type": ["integer", "null"], "minimum": 1, "maximum": 10 },
            "density_label": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "style": { "type": ["object", "null"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "status": { "type": "string" } }, "additionalProperties": true },
        "palette": { "type": ["object", "null"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "tokens": { "type": "object", "additionalProperties": { "type": "string" } } }, "additionalProperties": true },
        "typography": { "type": ["object", "null"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "headingFont": { "type": "string" }, "bodyFont": { "type": "string" }, "loadingNotes": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": true },
        "layoutStrategy": { "type": "string" },
        "interactionStrategy": { "type": "string" },
        "chartRecommendations": { "type": "array", "items": { "type": "object", "required": ["purpose", "reason"], "properties": { "type": { "type": "string" }, "purpose": { "type": "string" }, "reason": { "type": "string" }, "evidenceIds": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false } },
        "uxGuidelines": { "type": "array", "items": { "type": "object", "required": ["statement", "verification"], "properties": { "id": { "type": "string" }, "statement": { "type": "string" }, "verification": { "type": "string", "enum": ["automated", "manual", "not-applicable"] }, "evidenceId": { "type": "string" } }, "additionalProperties": false } },
        "techStackFit": { "type": "array", "items": { "type": "object", "required": ["stack", "compatible", "reason"], "properties": { "stack": { "type": "string" }, "compatible": { "type": ["boolean", "null"], "description": "Null until actual compatibility is verified; retrieved guidance alone is not proof of compatibility." }, "guidanceStatus": { "type": "string", "enum": ["not-requested", "matched", "no-matches"] }, "guidelineCount": { "type": "integer", "minimum": 0 }, "reason": { "type": "string" } }, "additionalProperties": false } },
        "tradeoffs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["eligible", "hardConstraints", "softPreferenceScore", "explanation", "reviewStatus"],
      "properties": {
        "eligible": { "type": ["boolean", "null"] },
        "hardConstraints": { "type": "array", "items": { "type": "object", "required": ["constraint", "passed"], "properties": { "constraint": { "type": "string" }, "passed": { "type": "boolean" }, "reason": { "type": "string" } }, "additionalProperties": false } },
        "softPreferenceScore": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "scoreBreakdown": { "type": "object", "additionalProperties": { "type": "number" } },
        "explanation": { "type": "array", "items": { "type": "string" } },
        "reviewStatus": { "type": "string", "enum": ["not-reviewed", "reviewed", "approved", "rejected"] },
        "conflicts": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["engine", "items"],
      "properties": {
        "engine": { "type": ["object", "null"], "properties": { "repository": { "type": "string" }, "version": { "type": "string" }, "commit": { "type": "string" }, "mode": { "type": "string", "enum": ["live", "cli", "build-time", "authored-fallback", "unknown"] } }, "additionalProperties": true },
        "items": { "type": "array", "items": { "type": "object", "required": ["id", "domain", "sourcePath"], "properties": { "id": { "type": "string" }, "domain": { "type": "string" }, "sourcePath": { "type": "string" }, "sourceHash": { "type": "string" }, "reasonUsed": { "type": "string" } }, "additionalProperties": false } },
        "limitations": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "preview": {
      "type": "object",
      "required": ["kind", "status"],
      "properties": {
        "kind": { "type": "string", "enum": ["interactive-prototype", "static-illustration", "implemented-application"] },
        "status": { "type": "string", "enum": ["available", "partial", "unavailable"] },
        "supportedViewports": { "type": "array", "items": { "type": "string", "enum": ["mobile", "tablet", "desktop"] } },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "sampleDataNotice": { "type": "string" }
      },
      "additionalProperties": false
    },
    "rawEngineOutput": {
      "type": "object",
      "description": "Verbatim upstream CLI/API output preserved for auditability.",
      "additionalProperties": true
    },
    "delivery": {
      "type": "object",
      "required": ["designSpecAvailable", "jsonAvailable", "markdownAvailable"],
      "properties": {
        "designSpecAvailable": { "type": "boolean" },
        "jsonAvailable": { "type": "boolean" },
        "markdownAvailable": { "type": "boolean" },
        "agentExecutionPerformed": { "type": "boolean" },
        "unresolvedRisks": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}